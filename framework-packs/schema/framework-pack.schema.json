{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/compliance-control-map/framework-pack.schema.json",
  "title": "Compliance Control Map framework pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["framework", "domains", "requirements"],
  "properties": {
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "name", "version", "description", "source_uri", "verified_on", "disclaimer"],
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "source_uri": { "type": "string" },
        "verified_on": { "type": "string", "format": "date" },
        "published_at": { "type": ["string", "null"], "format": "date" },
        "disclaimer": { "type": "string" }
      }
    },
    "domains": {
      "type": "array",
      "items": { "$ref": "#/$defs/domain" }
    },
    "requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/requirement" }
    }
  },
  "$defs": {
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["external_id", "name"],
      "properties": {
        "external_id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "parent_id": { "type": ["string", "null"] },
        "sort_order": { "type": "integer" }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["external_id", "domain_id", "title", "summary"],
      "properties": {
        "external_id": { "type": "string" },
        "domain_id": { "type": "string" },
        "parent_id": { "type": ["string", "null"] },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "guidance": { "type": "string" },
        "source_reference": { "type": "string" },
        "sort_order": { "type": "integer" }
      }
    }
  }
}
