# Local mode works with these defaults. The web app is available only on this machine.
COMPOSE_PROJECT_NAME=compliance-control-map
CCM_WEB_PORT=3000
CCM_LOAD_DEMO=true
CCM_MAX_UPLOAD_BYTES=52428800

# Model assistance is always optional and defaults off. To field-test local
# Ollama from the API container, enable it and allow only the exact endpoint.
CCM_INFERENCE_ENABLED=false
CCM_INFERENCE_ALLOWED_BASE_URLS=[]
CCM_INFERENCE_MAX_CONCURRENT_RUNS=2
CCM_INFERENCE_MAX_CONTEXT_CHARS=60000
CCM_INFERENCE_MAX_OUTPUT_CHARS=12000
CCM_INFERENCE_MAX_ITERATIONS=4
CCM_INFERENCE_MAX_TOOL_CALLS=8
CCM_INFERENCE_TIMEOUT_SECONDS=90

# Example when explicitly enabled:
# CCM_INFERENCE_ALLOWED_BASE_URLS=["http://host.docker.internal:11434/v1"]
# Hosted-provider secrets stay environment-only. A profile may reference
# env:CCM_MODEL_API_KEY but the value is never stored in the workspace database.
CCM_MODEL_API_KEY=

# Server/team mode: copy this file to .env, replace every CHANGE_ME value and
# both example.com host values, then run: .\launch.ps1 -Deployment server
CCM_WEB_BIND=0.0.0.0
CCM_POSTGRES_DB=compliance_control
CCM_POSTGRES_USER=ccm
CCM_POSTGRES_PASSWORD=CHANGE_ME_use_a_long_random_database_password
CCM_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
CCM_BOOTSTRAP_ADMIN_DISPLAY_NAME=Workspace administrator
CCM_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_use_a_passphrase_of_at_least_15_characters
CCM_SERVER_LOAD_DEMO=false

# The two bootstrap values create only the first Admin. After that Admin changes
# the password and confirms a new login, clear BOTH values on later restarts:
# CCM_BOOTSTRAP_ADMIN_EMAIL=
# CCM_BOOTSTRAP_ADMIN_PASSWORD=

# Replace this example hostname with the browser-facing server hostname.
CCM_ALLOWED_ORIGINS=["https://compliance.example.com"]
CCM_ALLOWED_HOSTS=["compliance.example.com","localhost","127.0.0.1"]
